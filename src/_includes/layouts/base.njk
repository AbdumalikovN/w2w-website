<!doctype html>
<html lang="ru" data-theme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{% if title %}{{ title }} — {% endif %}Win to Win</title>
  <meta name="description" content="{{ description or site.description }}">
  {% if noindex %}<meta name="robots" content="noindex">
  {% endif %}  <link rel="canonical" href="{{ site.domain }}{{ page.url }}">
  <link rel="alternate" hreflang="ru" href="{{ site.domain }}{{ page.url }}">
  <link rel="alternate" hreflang="uz" href="{{ site.domain }}/uz{{ page.url }}">
  <link rel="alternate" hreflang="en" href="{{ site.domain }}/en{{ page.url }}">
  <link rel="alternate" hreflang="x-default" href="{{ site.domain }}{{ page.url }}">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Win to Win">
  <meta property="og:title" content="{{ title or 'Win to Win' }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:locale" content="ru_RU">
  <meta property="og:image" content="{{ site.origin }}{{ '/assets/img/og-ru.jpg' | url }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="color-scheme" content="light dark">
  <meta name="theme-color" content="#F2F3F5" data-theme-color>
  <script>(function(d,w){var h=d.documentElement,t=null,b=null,q=location.search;h.classList.add("js");try{t=localStorage.getItem("w2w-theme")}catch(e){}if(t!=="light"&&t!=="dark"){t=w.matchMedia&&w.matchMedia("(prefers-color-scheme: dark)").matches?"dark":"light"}h.setAttribute("data-theme",t);var rm=w.matchMedia&&w.matchMedia("(prefers-reduced-motion: reduce)").matches;if(!rm){h.classList.add("motion");setTimeout(function(){if(!h.classList.contains("anim-ready"))h.classList.remove("motion")},4000)}try{b=sessionStorage.getItem("w2w-boot")}catch(e){}if(/[?&]boot=1/.test(q)||(!b&&!/[?&]boot=0/.test(q)&&!/bot|crawl|spider|lighthouse|headless/i.test(navigator.userAgent))){h.classList.add("boot")}try{var m=d.querySelector("meta[data-theme-color]");if(m)m.content=t==="dark"?"#08090B":"#F2F3F5"}catch(e){}})(document,window);</script>
  <link rel="icon" href="{{ '/assets/img/favicon.svg' | url }}" type="image/svg+xml">
  <link rel="preload" href="{{ '/assets/fonts/onest-800-cyrillic.woff2' | url }}" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="{{ '/assets/fonts/onest-400-cyrillic.woff2' | url }}" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="{{ '/assets/css/fonts.css' | url }}">
  <link rel="stylesheet" href="{{ '/assets/css/main.css' | url }}?v={{ build.v }}">
  <script type="application/ld+json">{"@context":"https://schema.org","@type":"Organization","name":"Win to Win","legalName":"{{ site.legal | replace('"', '') }}","url":"{{ site.domain }}","email":"{{ site.email }}","telephone":"{{ site.phone }}","address":{"@type":"PostalAddress","addressLocality":"Ташкент","addressCountry":"UZ","streetAddress":"ул. Шахрисабз, 25"}}</script>
</head>
<body class="{{ bodyClass }}">
  <a class="skip" href="#main">К содержанию</a>
  <div class="ambient" aria-hidden="true"><i></i><i></i><i></i></div>
  {% include "partials/boot.njk" %}
  {% include "partials/icons.njk" %}
  {% include "partials/header.njk" %}
  <main id="main" tabindex="-1">
    {{ content | safe }}
  </main>
  {% include "partials/footer.njk" %}
  {% include "partials/modals.njk" %}
  <div class="toast" data-toast role="status" aria-live="polite"></div>
  <script>
    window.W2W = {
      base: "{{ '/' | url }}",
      formEndpoint: {{ site.formEndpoint | jsonstr | safe }},
      thanks: "{{ '/thanks/' | url }}",
      clocks: {{ site.clocks | dump | safe }}
    };
  </script>
  <script src="{{ '/assets/vendor/gsap.min.js' | url }}" defer></script>
  <script src="{{ '/assets/vendor/ScrollTrigger.min.js' | url }}" defer></script>
  <script src="{{ '/assets/js/sound.js' | url }}?v={{ build.v }}" defer></script>
  <script src="{{ '/assets/js/core.js' | url }}?v={{ build.v }}" defer></script>
  <script src="{{ '/assets/js/request.js' | url }}?v={{ build.v }}" defer></script>
  <script src="{{ '/assets/js/game.js' | url }}?v={{ build.v }}" defer></script>
  {% for s in scripts %}<script src="{{ ('/assets/js/' + s + '.js') | url }}?v={{ build.v }}" defer></script>
  {% endfor %}
</body>
</html>
