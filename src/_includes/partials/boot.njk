<div class="boot" id="boot" role="status" aria-label="Загрузка сайта">
  <div class="boot-bg" aria-hidden="true"><i class="boot-glow"></i><i class="boot-floor"></i><i class="boot-scan"></i></div>
  <canvas class="boot-cv" aria-hidden="true"></canvas>
  <div class="boot-hud">
    <div class="boot-top">
      <p class="boot-brand"><svg class="boot-w" viewBox="335 262 445 555" aria-hidden="true"><path fill="currentColor" d="M475.92,558.01l18.53-17.94s18.25,106.28,62.54,123.07c44.29,16.79,54.72-110.94,54.72-110.94l7.23-136.7,141.05-141.05s-28.68,508.29-151.48,530.89c0,0-64.87,12.17-106.6-148.28l-26.08-99.05h.08Z"/><path fill="currentColor" d="M344.75,612.26l14.46-14.03s14.26,83.01,48.83,96.13c34.61,13.12,42.75-86.6,42.75-86.6l5.65-106.75,110.15-110.15s-22.4,396.91-118.29,414.53c0,0-50.65,9.48-83.21-115.8l-20.35-77.36v.04Z"/></svg><span><b>Win to Win</b><small>Company Brain · boot</small></span></p>
      <button class="boot-skip" type="button" data-boot-skip>Пропустить<svg class="i" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
    </div>
    <div class="boot-stats" aria-hidden="true">
      <p><span>Узлы знаний</span><b data-boot-stat="nodes">0</b></p>
      <p><span>Связи</span><b data-boot-stat="links">0</b></p>
      <p><span>Источники</span><b data-boot-stat="src">0</b></p>
    </div>
    <div class="boot-bottom">
      <ol class="boot-log" data-boot-log aria-hidden="true"></ol>
      <p class="boot-pct"><span class="sr-only">Загружено </span><b data-boot-num>0</b><small>%</small></p>
    </div>
    <div class="boot-bar" aria-hidden="true"><i data-boot-bar></i></div>
  </div>
</div>
<script src="{{ '/assets/js/loader.js' | url }}?v={{ build.v }}"></script>
