<header class="site-header" id="top" data-header>
  <div class="bar glass">
    {% include "partials/logo.njk" %}
    <nav class="site-nav" aria-label="Основная навигация">
      {% for item in nav.main %}
      <a href="{{ item.url | url }}"{% if page.url == item.url or (item.match and page.url.startsWith(item.match) and item.match != '/') %} aria-current="page"{% endif %}>{{ item.label }}</a>
      {% endfor %}
    </nav>
    <div class="site-tools">
      <button class="icon-btn" type="button" data-modal="search" aria-label="Поиск по сайту"><svg class="i"><use href="#i-search"/></svg></button>
      <button class="btn btn-sm btn-primary site-cta" type="button" data-modal="call">Записаться на созвон</button>
      <button class="icon-btn burger" type="button" aria-expanded="false" aria-controls="mobile-nav" aria-label="Открыть меню"><svg class="i i-open"><use href="#i-menu"/></svg><svg class="i i-close"><use href="#i-close"/></svg></button>
    </div>
  </div>
  <div class="mobile-nav" id="mobile-nav" aria-hidden="true">
    <nav aria-label="Мобильная навигация">
      {% for item in nav.main %}<a href="{{ item.url | url }}" tabindex="-1">{{ item.label }}</a>{% endfor %}
      {% for item in nav.more %}<a class="mobile-nav-more" href="{{ item.url | url }}" tabindex="-1">{{ item.label }}</a>{% endfor %}
    </nav>
    <div class="mobile-nav-actions">
      <button class="btn btn-primary" type="button" data-modal="call" tabindex="-1">Записаться на созвон</button>
      <button class="btn btn-outline" type="button" data-modal="search" tabindex="-1">Поиск по сайту</button>
    </div>
    <p class="mobile-nav-contact"><a href="{{ site.phoneHref }}" tabindex="-1">{{ site.phone }}</a><br><a href="mailto:{{ site.email }}" tabindex="-1">{{ site.email }}</a></p>
  </div>
</header>
