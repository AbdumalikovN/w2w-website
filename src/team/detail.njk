---
layout: layouts/base.njk
pagination:
  data: team
  size: 1
  alias: m
permalink: "/team/{{ m.slug }}/"
eleventyComputed:
  title: "{{ m.name }} — {{ m.role }}"
  description: "{{ m.lead }}"
---
{% set so = m.socials %}
{% set first = m.name.split(' ')[0] %}
<section class="hero-page pd-hero">
  <div class="wrap pd-in">
    <div class="pd-copy">
      <p class="crumbs"><a href="{{ '/' | url }}">Главная</a><span>/</span><a href="{{ '/team/' | url }}">Команда</a><span>/</span>{{ m.name }}</p>
      <p class="pd-code"><span class="dot-live" aria-hidden="true"></span>{{ m.code }} · Win to Win</p>
      <h1 class="h1 pd-name">{{ m.name }}</h1>
      <p class="pd-role">{{ m.role }}</p>
      <p class="lead">{{ m.lead }}</p>
      <div class="pd-contact">
        {% if so.telegram %}<a class="btn btn-brand" href="{{ so.telegram | tgHref }}" target="_blank" rel="noopener"><svg class="i" aria-hidden="true"><use href="#i-telegram"/></svg>Написать в Telegram</a>{% else %}<button class="btn btn-brand" type="button" data-modal="request">Написать {{ first }}</button>{% endif %}
        <div class="pd-soc">
          {% if so.telegram %}<a class="tm-s tm-s-tg" href="{{ so.telegram | tgHref }}" target="_blank" rel="noopener" aria-label="Telegram" title="Telegram"><svg aria-hidden="true"><use href="#i-telegram"/></svg></a>{% endif %}
          {% if so.instagram %}<a class="tm-s tm-s-ig" href="{{ so.instagram | igHref }}" target="_blank" rel="noopener" aria-label="Instagram" title="Instagram"><svg aria-hidden="true"><use href="#i-instagram"/></svg></a>{% endif %}
          {% if so.linkedin %}<a class="tm-s tm-s-in" href="{{ so.linkedin }}" target="_blank" rel="noopener" aria-label="LinkedIn" title="LinkedIn"><svg aria-hidden="true"><use href="#i-linkedin"/></svg></a>{% endif %}
          {% if so.whatsapp %}<a class="tm-s tm-s-wa" href="{{ so.whatsapp | waHref }}" target="_blank" rel="noopener" aria-label="WhatsApp" title="WhatsApp"><svg aria-hidden="true"><use href="#i-whatsapp"/></svg></a>{% endif %}
          {% if so.email %}<a class="tm-s tm-s-mail" href="mailto:{{ so.email }}" aria-label="{{ so.email }}" title="{{ so.email }}"><svg aria-hidden="true"><use href="#i-mail"/></svg></a>{% endif %}
          <a class="tm-s tm-s-mail" href="mailto:{{ site.email }}" aria-label="Почта компании {{ site.email }}" title="{{ site.email }}"><svg aria-hidden="true"><use href="#i-mail"/></svg></a>
        </div>
      </div>
    </div>
    <div class="pd-visual">
      <div class="pd-photo tm-{{ m.slug }}">
        <span class="tm-bg" aria-hidden="true"></span>
        {% if m.photo %}<img src="{{ ('/assets/img/team/' + m.photo + '.webp') | url }}" alt="{{ m.name }}" width="800" height="1000" fetchpriority="high">{% else %}<span class="tm-initials" aria-hidden="true">{{ m.name | initials }}</span>{% endif %}
      </div>
      <ul class="pd-chips" aria-label="Ключевые навыки">
        {% for s in m.skills %}<li style="--i: {{ loop.index0 }}">{{ s }}</li>{% endfor %}
      </ul>
    </div>
  </div>
</section>

<section class="section pd-facts-sec">
  <div class="wrap">
    <div class="pd-facts">
      <div><small>В команде</small><b>с {{ m.since }}</b></div>
      <div><small>Направление</small><b>{{ m.dept }}</b></div>
      <div><small>Срок реакции</small><b>{{ m.reaction }}</b></div>
      <div><small>Решает</small><b>{{ m.solves }}</b></div>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap split">
    <div class="split-sticky">
      <p class="eyebrow"><span class="eb-dot" aria-hidden="true"></span>О человеке</p>
      <h2 class="h2 h2-sm">Чем занимается {{ first }}</h2>
    </div>
    <div class="prose pd-bio">
      {% for p in m.bio %}<p>{{ p }}</p>{% endfor %}
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <p class="eyebrow"><span class="eb-dot" aria-hidden="true"></span>Зона ответственности</p>
        <h2 class="h2 h2-sm">За что отвечает</h2>
      </div>
    </div>
    <div class="pd-own">
      {% for o in m.own %}
      <div class="pd-own-i">
        <span class="app-icon md ic-{{ [1,2,8,5][loop.index0] }}" aria-hidden="true"><svg><use href="#{{ ['i-target','i-gears','i-shield','i-sparkle'][loop.index0] }}"/></svg></span>
        <h3>{{ o[0] }}</h3>
        <p>{{ o[1] }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="pd-when">
      <div>
        <p class="eyebrow"><span class="eb-dot" aria-hidden="true"></span>Когда писать</p>
        <h2 class="h2 h2-sm">Пишите {{ first }}, если у вас</h2>
        <ul class="check-list mt-24">
          {% for w in m.when %}<li><svg class="i" aria-hidden="true"><use href="#i-check"/></svg>{{ w }}</li>{% endfor %}
        </ul>
      </div>
      <div class="pd-when-card">
        <p class="pd-when-k">Ответ</p>
        <p class="pd-when-v">{{ m.reaction }}</p>
        <p class="muted">Быстрее всего — через форму заявки: она сразу попадает в Telegram команды, а {{ first }} подключается, если вопрос в {{ 'её' if m.gender == 'f' else 'его' }} зоне.</p>
        <button class="btn btn-brand btn-block" type="button" data-modal="request">Оставить заявку</button>
      </div>
    </div>
  </div>
</section>

<section class="section tm">
  <div class="wrap">
    <div class="sec-head">
      <h2 class="h2 h2-sm">Другие руководители</h2>
      <a class="btn btn-glass" href="{{ '/team/' | url }}">Вся команда<svg class="i" aria-hidden="true"><use href="#i-arrow"/></svg></a>
    </div>
    <div class="tm-grid tm-grid-4">
      {% for m2 in team %}{% if m2.slug != m.slug %}{% set pm = m2 %}{% include "partials/person-card.njk" %}{% endif %}{% endfor %}
    </div>
  </div>
</section>

{% include "partials/cta.njk" %}
